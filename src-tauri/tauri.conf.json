{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "Marginália Notes",
 "mainBinaryName": "Marginalia Notes",
 "version": "0.1.0",
 "identifier": "app.notaslocais",
 "build": {
  "frontendDist": "../src"
 },
 "app": {
  "withGlobalTauri": true,
  "windows": [
   {
    "title": "Marginália Notes",
    "width": 1100,
    "height": 740,
    "minWidth": 420,
    "minHeight": 520,
    "transparent": true,
    "dragDropEnabled": false
   }
  ],
  "security": {
   "csp": null
  },
  "macOSPrivateApi": true
 },
 "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
   "icons/32x32.png",
   "icons/128x128.png",
   "icons/128x128@2x.png",
   "icons/icon.png",
   "icons/icon.icns",
   "icons/icon.ico"
  ],
  "category": "Productivity",
  "shortDescription": "Notas em Markdown, locais e privadas",
  "linux": {
   "deb": {
    "section": "editors"
   },
   "appimage": {
    "bundleMediaFramework": true
   }
  }
 }
}